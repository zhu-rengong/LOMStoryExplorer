# 抽取/构建的中间产物，可由 extract.py + build.py 重新生成
data/lua/
data/locale/
data/cache/
data/manifest.json
data/report.json
data/checkpoints.json
data/entries.json

# 前端生成数据：build.py 输出的 graph.js / text-*.js / checkpoints-*.js / wordcount.js，
