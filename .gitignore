docs/data/

# 开发期截图（旧的散落在 docs/，新的统一在 tools/shots/）
docs/_shot-*.png
tools/shots/

# Python 缓存 / 虚拟环境
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# CodeBuddy 计划存档：本地工作产物，规则文件仍入库
.codebuddy/plans/

# 编辑器 / 系统杂项
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.log
